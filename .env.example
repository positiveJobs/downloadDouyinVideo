# 复制本文件为 .env 后按需修改。
# .env 已加入 .gitignore，不会被提交；请勿把真实 Cookie 写进任何会被提交的文件。

# 浏览器运行模式（布尔语义）：
#   true  → 无头模式（不显示窗口，默认）
#   false → 有头模式（显示浏览器窗口，便于观察页面）
HEADLESS=true

# 可选：仅命令行入口（main.py）会读取此变量。
# Web 服务不读取它，请直接在网页中填写 Cookie。
# Cookie 等同账号凭据，切勿提交、截图或分享。
# DOUYIN_COOKIES=sessionid=...; ttwid=...; s_v_web_id=...
